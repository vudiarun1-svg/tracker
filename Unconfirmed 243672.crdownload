while True:

    print("\n======================================")
    print("      ASPNA PERFORMANCE TRACKER")
    print("======================================")

    print("1. Daily Check-In")
    print("2. Log Workout")
    print("3. View Daily History")
    print("4. View Workout History")
    print("5. Performance Report")
    print("6. Exercise Progress")
    print("7. Progress Dashboard")
    print("8. Exit")


    choice = input(
        "\nChoose an option: "
    )


    if choice == "1":

        add_daily_checkin()


    elif choice == "2":

        add_workout()


    elif choice == "3":

        view_daily_history()


    elif choice == "4":

        view_workout_history()


    elif choice == "5":

        performance_report()


    elif choice == "6":

        exercise_progress()


    elif choice == "7":

        dashboard()


    elif choice == "8":

        print(
            "\nAspna data saved."
        )

        break


    else:

        print(
            "\nInvalid option."
        )