import pandas as pd
import matplotlib.pyplot as plt
from google.colab import drive
from datetime import datetime
import os

drive.mount("/content/drive")

folder = "/content/drive/MyDrive/AspnaTracker"

os.makedirs(folder, exist_ok=True)

daily_file = folder + "/daily_data.csv"
workout_file = folder + "/workout_data.csv"


daily_columns = [
    "Date",
    "Weight",
    "Calories",
    "Protein",
    "Steps",
    "Sleep Hours",
    "Sleep Score",
    "Water",
    "Energy",
    "Soreness",
    "Workout Completed",
    "Workout Type",
    "Notes"
]

workout_columns = [
    "Date",
    "Workout Type",
    "Exercise",
    "Weight",
    "Reps",
    "Sets",
    "Volume"
]


if not os.path.exists(daily_file):

    pd.DataFrame(
        columns=daily_columns
    ).to_csv(
        daily_file,
        index=False
    )


if not os.path.exists(workout_file):

    pd.DataFrame(
        columns=workout_columns
    ).to_csv(
        workout_file,
        index=False
    )


def add_daily_checkin():

    print("\n==============================")
    print("       DAILY CHECK-IN")
    print("==============================")

    date = input(
        "Date (YYYY-MM-DD) or press Enter for today: "
    )

    if date == "":
        date = datetime.today().strftime("%Y-%m-%d")

    weight = float(input("Bodyweight (lb): "))

    calories = int(input("Calories eaten: "))

    protein = int(input("Protein (g): "))

    steps = int(input("Steps: "))

    sleep_hours = float(
        input("Sleep hours: ")
    )

    sleep_score = int(
        input("Sleep score (0-100): ")
    )

    water = float(
        input("Water intake (liters): ")
    )

    energy = int(
        input("Energy level (1-10): ")
    )

    soreness = int(
        input("Soreness (1-10): ")
    )

    completed = input(
        "Workout completed? (yes/no): "
    ).lower()

    workout_type = input(
        "Workout type: "
    )

    notes = input(
        "Daily notes: "
    )


    new_entry = pd.DataFrame([{

        "Date": date,

        "Weight": weight,

        "Calories": calories,

        "Protein": protein,

        "Steps": steps,

        "Sleep Hours": sleep_hours,

        "Sleep Score": sleep_score,

        "Water": water,

        "Energy": energy,

        "Soreness": soreness,

        "Workout Completed": completed,

        "Workout Type": workout_type,

        "Notes": notes
    }])


    old_data = pd.read_csv(
        daily_file
    )


    old_data = old_data[
        old_data["Date"] != date
    ]


    data = pd.concat(
        [old_data, new_entry],
        ignore_index=True
    )


    data.to_csv(
        daily_file,
        index=False
    )


    print("\nDaily check-in saved.")



def add_workout():

    print("\n==============================")
    print("         LOG WORKOUT")
    print("==============================")

    date = input(
        "Date (YYYY-MM-DD) or press Enter for today: "
    )

    if date == "":
        date = datetime.today().strftime("%Y-%m-%d")


    workout_type = input(
        "Workout type: "
    )


    while True:

        print()

        exercise = input(
            "Exercise name or type 'done': "
        )


        if exercise.lower() == "done":
            break


        weight = float(
            input("Weight used: ")
        )

        reps = int(
            input("Reps: ")
        )

        sets = int(
            input("Sets: ")
        )


        volume = (
            weight
            * reps
            * sets
        )


        new_set = pd.DataFrame([{

            "Date": date,

            "Workout Type": workout_type,

            "Exercise": exercise,

            "Weight": weight,

            "Reps": reps,

            "Sets": sets,

            "Volume": volume
        }])


        old_workouts = pd.read_csv(
            workout_file
        )


        workouts = pd.concat(
            [old_workouts, new_set],
            ignore_index=True
        )


        workouts.to_csv(
            workout_file,
            index=False
        )


        print(
            "Exercise saved. Volume:",
            round(volume)
        )



def view_daily_history():

    data = pd.read_csv(
        daily_file
    )


    if len(data) == 0:

        print(
            "\nNo daily data saved yet."
        )

        return


    print("\n==============================")
    print("         DAILY HISTORY")
    print("==============================")

    print(
        data.to_string(
            index=False
        )
    )



def view_workout_history():

    workouts = pd.read_csv(
        workout_file
    )


    if len(workouts) == 0:

        print(
            "\nNo workouts saved yet."
        )

        return


    print("\n==============================")
    print("        WORKOUT HISTORY")
    print("==============================")

    print(
        workouts.to_string(
            index=False
        )
    )



def performance_report():

    data = pd.read_csv(
        daily_file
    )

    workouts = pd.read_csv(
        workout_file
    )


    if len(data) == 0:

        print(
            "\nAdd daily data first."
        )

        return


    data["Date"] = pd.to_datetime(
        data["Date"]
    )


    data = data.sort_values(
        "Date"
    )


    print("\n======================================")
    print("       PERFORMANCE REPORT")
    print("======================================")


    avg_weight = data[
        "Weight"
    ].mean()


    avg_calories = data[
        "Calories"
    ].mean()


    avg_protein = data[
        "Protein"
    ].mean()


    avg_steps = data[
        "Steps"
    ].mean()


    avg_sleep = data[
        "Sleep Hours"
    ].mean()


    avg_sleep_score = data[
        "Sleep Score"
    ].mean()


    avg_energy = data[
        "Energy"
    ].mean()


    avg_soreness = data[
        "Soreness"
    ].mean()


    completed = (
        data["Workout Completed"]
        .astype(str)
        .str.lower()
        .eq("yes")
        .sum()
    )


    workout_adherence = (
        completed / len(data)
    ) * 100


    print(
        f"Days Tracked: {len(data)}"
    )

    print(
        f"Average Weight: {avg_weight:.1f} lb"
    )

    print(
        f"Average Calories: {avg_calories:.0f}"
    )

    print(
        f"Average Protein: {avg_protein:.0f} g"
    )

    print(
        f"Average Steps: {avg_steps:.0f}"
    )

    print(
        f"Average Sleep: {avg_sleep:.1f} hours"
    )

    print(
        f"Average Sleep Score: {avg_sleep_score:.0f}/100"
    )

    print(
        f"Average Energy: {avg_energy:.1f}/10"
    )

    print(
        f"Average Soreness: {avg_soreness:.1f}/10"
    )

    print(
        f"Workout Adherence: {workout_adherence:.1f}%"
    )


    if len(data) >= 2:

        first_weight = data.iloc[0][
            "Weight"
        ]

        latest_weight = data.iloc[-1][
            "Weight"
        ]

        weight_change = (
            latest_weight
            - first_weight
        )


        print(
            f"Weight Change: {weight_change:+.1f} lb"
        )


    if len(workouts) > 0:

        total_volume = workouts[
            "Volume"
        ].sum()

        print(
            f"Total Training Volume: {total_volume:,.0f} lb"
        )



def exercise_progress():

    workouts = pd.read_csv(
        workout_file
    )


    if len(workouts) == 0:

        print(
            "\nNo workout data yet."
        )

        return


    print()

    exercise = input(
        "Exercise to analyze: "
    )


    exercise_data = workouts[
        workouts["Exercise"]
        .str.lower()
        == exercise.lower()
    ].copy()


    if len(exercise_data) == 0:

        print(
            "No data found."
        )

        return


    exercise_data[
        "Date"
    ] = pd.to_datetime(
        exercise_data["Date"]
    )


    exercise_data = exercise_data.sort_values(
        "Date"
    )


    print()

    print(
        exercise_data[
            [
                "Date",
                "Weight",
                "Reps",
                "Sets",
                "Volume"
            ]
        ].to_string(
            index=False
        )
    )


    plt.figure(
        figsize=(10, 5)
    )


    plt.plot(
        exercise_data["Date"],
        exercise_data["Volume"],
        marker="o"
    )


    plt.title(
        exercise + " Training Volume"
    )


    plt.xlabel(
        "Date"
    )


    plt.ylabel(
        "Volume"
    )


    plt.xticks(
        rotation=45
    )


    plt.tight_layout()

    plt.show()



def dashboard():

    data = pd.read_csv(
        daily_file
    )


    if len(data) < 2:

        print(
            "\nTrack at least 2 days first."
        )

        return


    data[
        "Date"
    ] = pd.to_datetime(
        data["Date"]
    )


    data = data.sort_values(
